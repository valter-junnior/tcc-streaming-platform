architecture-beta
    group frontend(cloud)[Frontend]
    group backend(cloud)[Backend Services]
    group streaming_a(server)[Servidor A: Nginx-RTMP]
    group streaming_b(server)[Servidor B: SRS]
    group data(database)[Data Layer]
    group monitoring(cloud)[Monitoring]

    service react[React App] in frontend
    service api[Stream Service] in backend
    service consumer[Consumer Service] in backend

    service nginx_rtmp[Nginx-RTMP] in streaming_a
    service ffmpeg_a[FFmpeg] in streaming_a
    service nginx_hls[Nginx HLS] in streaming_a

    service srs[SRS Server] in streaming_b
    service ffmpeg_b[FFmpeg] in streaming_b

    service postgres[PostgreSQL] in data
    service redis[Redis Cache] in data
    service rabbitmq[RabbitMQ] in data

    service prometheus[Prometheus] in monitoring
    service grafana[Grafana] in monitoring

    react:R -- L:api
    api:R -- L:postgres
    api:R -- L:redis
    api:B -- T:rabbitmq
    consumer:T -- B:rabbitmq
    nginx_rtmp:R -- L:ffmpeg_a
    ffmpeg_a:R -- L:nginx_hls
    nginx_hls:T -- B:react
    srs:R -- L:ffmpeg_b
    srs:B -- T:react
    api:B -- T:prometheus
    prometheus:R -- L:grafana
