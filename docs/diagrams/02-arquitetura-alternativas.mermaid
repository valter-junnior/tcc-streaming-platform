flowchart TB
    OBS["OBS Studio / Streamer (RTMP)"]

    subgraph Ingestion["Camada de Ingestão RTMP"]
        NGX["Nginx-RTMP ⭐ Implementação A"]
        SRS["SRS Server ⭐ Implementação B"]
    end

    subgraph Transcoding["Transcodificação (FFmpeg — ambos os servidores)"]
        FFmpeg["FFmpeg 4 qualidades: 1080p - 360p"]
    end

    subgraph HLSDelivery["Entrega — HLS"]
        HLS["HTTP Server (Nginx)"]
    end

    subgraph Broker["Message Broker"]
        MB["RabbitMQ"]
    end

    subgraph Backend["Backend"]
        API["Stream Service (Spring Boot)"]
        Consumer["Consumer Service (Spring Boot)"]
    end

    subgraph Data["Data Layer"]
        DB["PostgreSQL"]
        Cache["Redis"]
    end

    subgraph Monitoring["Monitoring"]
        Prom["Prometheus"]
        Graf["Grafana Dashboards comparativos"]
    end

    Browser["Browser / Viewer (HLS.js + Plyr)"]

    OBS -->|RTMP :1935| NGX
    OBS -->|RTMP :1935| SRS
    NGX -->|exec transcode-ffmpeg.sh| FFmpeg
    SRS -->|exec transcode-ffmpeg.sh| FFmpeg
    FFmpeg --> HLS
    HLS --> Browser

    NGX & SRS -.->|callback HTTP on_publish / on_publish_done| API
    API --> MB
    MB --> Consumer
    Consumer --> DB
    API --> Cache

    API & Consumer --> Prom
    Prom --> Graf

    style NGX fill:#90EE90
    style SRS fill:#90EE90
    style FFmpeg fill:#FFD700
    style HLS fill:#87CEEB
    style MB fill:#90EE90
