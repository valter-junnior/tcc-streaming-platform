flowchart TB
    OBS["OBS Studio / Streamer\n(RTMP)"]

    subgraph Ingestion["Camada de Ingestão RTMP"]
        NGX["Nginx-RTMP\n⭐ Implementação A"]
        SRS["SRS Server\n⭐ Implementação B"]
    end

    subgraph Transcoding["Transcodificação (FFmpeg em ambos)"]
        FFmpeg["FFmpeg\n4 qualidades: 1080p / 720p / 480p / 360p\nmaster.m3u8 + v0..v3/playlist.m3u8"]
    end

    subgraph HLSDelivery["Delivery: Protocolo 1 — HLS"]
        HLS["Nginx HTTP\nSegmentos .ts + playlists .m3u8\n~3–10s de latência"]
    end

    subgraph WebRTCDelivery["Delivery: Protocolo 2 — WebRTC"]
        WRT["SRS WebRTC\nConversão RTMP→WebRTC nativa\n~100–300ms de latência"]
    end

    subgraph Broker["Message Broker"]
        MB2["RabbitMQ\n⭐ Principal"]
        MB3["Redis Streams\nAlternativa"]
    end

    subgraph Backend["Backend"]
        API["Stream Service\n(Spring Boot)"]
        Consumer["Consumer Service\n(Spring Boot)"]
    end

    subgraph Data["Data Layer"]
        DB["PostgreSQL"]
        Cache["Redis Cache"]
    end

    subgraph Monitoring["Monitoring"]
        Prom["Prometheus"]
        Graf["Grafana\nDashboards comparativos"]
    end

    Browser["Browser / Viewer\n(HLS.js ou WebRTC nativo)"]

    OBS -->|RTMP :1935| NGX
    OBS -->|RTMP :1935| SRS
    NGX -->|exec transcode-ffmpeg.sh| FFmpeg
    SRS -->|exec transcode-ffmpeg.sh| FFmpeg
    FFmpeg --> HLS
    SRS -->|nativo| WRT
    HLS --> Browser
    WRT --> Browser

    NGX & SRS -.->|callback HTTP| API
    API --> MB2 & MB3
    MB2 & MB3 --> Consumer
    Consumer --> DB
    API --> Cache

    API & Consumer --> Prom
    Prom --> Graf

    %% Matriz 2x2
    note1["Matriz 2×2:\nA+HLS | A+WebRTC\nB+HLS | B+WebRTC"]

    style NGX fill:#90EE90
    style SRS fill:#90EE90
    style FFmpeg fill:#FFD700
    style HLS fill:#87CEEB
    style WRT fill:#87CEEB
    style MB2 fill:#90EE90
