flowchart TB
    subgraph Frontend
        React[React App<br/>]
    end
    
    subgraph "Backend Services"
        StreamAPI[Stream Service<br/>Spring Boot]
        Consumer[Consumer Service<br/>Spring Boot]
        Metrics[Metrics Service<br/>Spring Boot]
    end
    
    subgraph "RTMP Ingestion (Escolha 1 de 2)"
        RTMP1[Nginx-RTMP<br/>⭐ Principal]
        RTMP2[SRS<br/>Alternativa 1]
    end
    
    subgraph "Video Processing"
        Proc1[FFmpeg<br/>⭐ via exec Nginx-RTMP]
    end
    
    subgraph "HLS Serving"
        HLS1[Nginx<br/>]
    end
    
    subgraph "Message Broker (Escolha 1 de 3)"
        MB2[RabbitMQ<br/>⭐ Principal]
        MB3[Redis Streams<br/>Alternativa 1]
        MB4[NATS<br/>Alternativa 2]
    end
    
    subgraph "Cache"
        Cache1[Redis<br/>]
    end
    
    subgraph "Database (Escolha 1 de 2)"
        DB1[PostgreSQL<br/> ⭐ Principal]
        DB3[MongoDB<br/>Alternativa 1]
    end
    
    subgraph "Monitoring"
        Prom[Prometheus]
        Graf[Grafana]
    end
    
    %% Connections
    React --> StreamAPI
    StreamAPI --> Cache1
    StreamAPI --> DB1 & DB3
    StreamAPI --> MB2 & MB3 & MB4
    
    RTMP1 & RTMP2 --> Proc1 & Proc2
    Proc1 & Proc2 --> HLS1
    HLS1 --> React
    
    RTMP1 & RTMP2 & RTMP3 -.-> MB2 & MB3 & MB4
    MB2 & MB3 & MB4 --> Consumer
    Consumer --> StreamAPI
    
    StreamAPI & Consumer & Metrics --> Prom
    Prom --> Graf
    
    style RTMP1 fill:#90EE90
    style Proc1 fill:#90EE90
    style HLS1 fill:#90EE90
    style MB2 fill:#90EE90
    style Cache1 fill:#90EE90
    style DB1 fill:#90EE90
