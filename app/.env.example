# Database Configuration
POSTGRES_DB=streaming_db
POSTGRES_USER=streaming_user
POSTGRES_PASSWORD=streaming_pass
POSTGRES_PORT=5432

# RabbitMQ Configuration
RABBITMQ_USER=streaming_user
RABBITMQ_PASSWORD=streaming_pass
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Backend Configuration
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# RTMP Server Configuration
RTMP_PORT=1935
RTMP_CHUNK_SIZE=4096
HLS_PATH=/tmp/hls
HLS_HTTP_PORT=8081
HLS_PORT=8081
HLS_RETENTION_HOURS=6

# Transcoder: ffmpeg | gstreamer
TRANSCODER=ffmpeg

# Frontend Configuration
FRONTEND_PORT=3001
VITE_API_URL=http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080
VITE_RTMP_URL=rtmp://localhost:1935/live
VITE_HLS_URL=http://localhost:8081/hls
VITE_APP_URL=http://localhost:3001
