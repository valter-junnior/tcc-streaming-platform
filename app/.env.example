# Database Configuration
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# RabbitMQ Configuration
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Backend Configuration
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# RTMP Server Configuration
RTMP_PORT=1935
HLS_PORT=8081

# Transcoding Configuration
TRANSCODING_ENGINE=ffmpeg

# Frontend Configuration
FRONTEND_PORT=3001
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws
VITE_RTMP_URL=rtmp://localhost:1935/live
VITE_HLS_URL=http://localhost:8081/hls
VITE_APP_URL=http://localhost:3001
# Backend host for Vite proxy (use 'streaming-platform' for Docker, 'localhost' for local dev)
VITE_BACKEND_HOST=streaming-platform
VITE_BACKEND_PORT=8080
